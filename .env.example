# Copy to `.env` and adjust for your machine. Values are read from the
# environment (not auto-loaded); scripts/bootstrap.ps1 creates `.env` for you.

# Runtime environment: dev | staging | prod
APP_ENV=dev

# Logging level for the root logger (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# API settings
API_HOST=127.0.0.1
API_PORT=8000

# MongoDB (primary database) - Motor async driver, URI format:
#   mongodb://[user:pass@]host[:port][/dbname][?options]
# Never commit real credentials; keep this file value as your local dev value only.
# Port 27018: the local dev cluster avoids a conflict with a system MongoDB on 27017.
MONGODB_URI=mongodb://aiagent:aiagent@localhost:27018/aiagent?authSource=admin
MONGODB_DATABASE=aiagent

# Optional MongoDB tuning (defaults in config/env/<APP_ENV>.yaml)
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
# MONGODB_CONNECT_TIMEOUT_MS=5000
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_MIN_POOL_SIZE=0